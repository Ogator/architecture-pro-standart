@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()

title Диаграмма компонентов C4 — приём и обработка кредитной заявки онлайн

Container(gw, "API Gateway", "Spring Cloud Gateway", "Единая точка входа для сайта и интернет-банка")
Container(notify, "Сервис уведомлений и кодов подтверждения", "Java 17, Spring Boot", "Существующий сервис MVP: СМС-код и уведомления о статусе")
Container(abs_adapter, "Адаптер АБС", "Java 17, Spring Boot", "Существующий сервис MVP: обмен с АБС через PL/SQL-контракт")
ContainerQueue(kafka, "Шина событий", "Apache Kafka", "События заявок, решений и уведомлений")
ContainerDb(app_db, "БД кредитных заявок", "PostgreSQL: отдельная база и учётная запись в кластере платформы", "Заявки, история статусов, ключи идемпотентности. Паспортные данные лидов — в обособленной схеме с шифрованием и ограниченным сроком хранения")
ContainerDb(offer_db, "БД предложений и каталога", "PostgreSQL: отдельная база и учётная запись в кластере платформы", "Предодобренные предложения со сроком действия и версией расчёта, реплика каталога кредитных условий, витрина сегментации")

System(pipeline, "Кредитный конвейер", "BPM Camunda, Oracle. Обработка заявок и решение о выдаче, 24/7")
System(scoring, "Система кредитного скоринга", "Python, Flask. Перегружена в рабочие часы")
System(abs, "АБС", "Данные клиента, счета, зачисление средств")
System_Ext(bki, "Бюро кредитных историй", "Внешний REST API")

Container_Boundary(app_svc, "Сервис кредитных заявок (Java 17, Spring Boot)") {
  Component(api, "API кредитных заявок", "REST Controller", "Приём заявок с сайта и из интернет-банка, выдача статуса. Разный обязательный состав полей для каждого канала")
  Component(validator, "Правила приёма заявки", "Domain Service", "Проверяет полноту данных и определяет сценарий: заявка-лид без решения или заявка с предварительным решением")
  Component(matcher, "Сопоставление клиента и заявки", "Domain Service", "Ищет действующего клиента и уже открытую заявку по телефону, Ф. И. О. и паспортным данным. Возвращает найденную заявку вместо создания дубля")
  Component(registry, "Реестр заявок", "Spring Data JPA", "Сквозной идентификатор заявки, статусы, история переходов, ключ идемпотентности")
  Component(orchestrator, "Оркестратор предварительного решения", "Domain Service", "Синхронный сценарий сайта: укладывается в бюджет времени, при его исчерпании переводит заявку в обычный срок рассмотрения")
  Component(scoring_client, "Клиент скоринга", "REST Client, Resilience4j", "Таймаут, ограничение частоты и предохранитель. Не даёт онлайн-каналам перегрузить скоринг в рабочие часы")
  Component(events, "Издатель и обработчик событий", "Kafka Producer / Listener", "Публикует «заявка принята», принимает решения и статусы из конвейера")
}

Container_Boundary(offer_svc, "Сервис предодобренных предложений (Java 17, Spring Boot)") {
  Component(night, "Планировщик ночного расчёта", "Spring Scheduler", "Запускает пакетный расчёт только в непиковом окне и останавливает его при выходе за границу окна")
  Component(segmenter, "Сегментатор клиентов", "Domain Service", "Отбирает клиентов для предрасчёта по реплике данных АБС, а не запросами в АБС")
  Component(batch_client, "Пакетный клиент скоринга", "REST Client", "Отдельная квота и ограничение скорости, докат прерванной пачки на следующую ночь")
  Component(offer_store, "Хранилище предложений", "Spring Data JPA", "Сумма, ставка, срок действия предложения, версия расчёта")
  Component(offer_api, "API предодобренных предложений", "REST Controller", "Отдаёт клиенту интернет-банка действующее предложение")
  Component(catalog_api, "API витрины кредитных условий", "REST Controller", "Отдаёт сайту и интернет-банку условия кредитных продуктов из реплики каталога")
  Component(recheck, "Упрощённая перепроверка", "Domain Service", "При подаче заявки проверяет только изменения: стоп-факторы и свежие события по клиенту, лёгкий профиль скоринга")
}

Container_Boundary(pipe_adapter, "Адаптер Кредитного конвейера (Java 17, Spring Boot)") {
  Component(mapper, "Маппинг заявки в процесс", "Domain Service", "Переменные процесса, признак «заявка по предодобренному предложению» для ускоренного маршрута")
  Component(start_client, "Клиент запуска процесса", "REST Client (Camunda API)", "Стартует процесс в конвейере сразу при подаче заявки — в обход суточного обмена из АБС")
  Component(decision_consumer, "Обработчик решений и статусов", "REST Endpoint / Listener", "Принимает от конвейера решение по заявке и промежуточные статусы")
  Component(catalog_sync, "Синхронизация каталога условий", "Scheduled Job", "Периодически забирает из конвейера продуктовые условия по кредитам и обновляет реплику для витрины — каналы не ходят в конвейер за каждым показом страницы")
}

Rel(gw, api, "Подача заявки, запрос статуса", "REST")
Rel(gw, offer_api, "Запрос предодобренного предложения клиента", "REST")
Rel(gw, catalog_api, "Витрина кредитных условий для сайта и интернет-банка", "REST")
Rel(catalog_api, offer_db, "Читает реплику каталога условий", "JDBC")
Rel(catalog_sync, pipeline, "Забирает продуктовые условия", "REST")
Rel(catalog_sync, offer_db, "Обновляет реплику каталога условий", "JDBC")
Rel(api, validator, "Проверяет состав данных")
Rel(api, matcher, "Ищет клиента и открытую заявку")
Rel(matcher, abs_adapter, "Запрашивает поиск клиента", "REST")
Rel(abs_adapter, abs, "Поиск клиента и счёта, инициирование зачисления", "PL/SQL API")
Rel(api, registry, "Создаёт или продолжает заявку")
Rel(registry, app_db, "Читает и пишет", "JDBC")
Rel(validator, orchestrator, "Передаёт заявку с паспортными данными на предварительное решение")
Rel(orchestrator, scoring_client, "Запрашивает экспресс-скоринг")
Rel(orchestrator, recheck, "Для заявки по предодобренному предложению запускает упрощённую перепроверку")
Rel(scoring_client, scoring, "Скоринг по заявке", "REST")
Rel(scoring, bki, "Общие данные кредитной истории", "REST, онлайн")
Rel(api, events, "Публикует принятую заявку")
Rel(events, kafka, "Публикует и читает события", "Kafka")
Rel(kafka, mapper, "Событие «заявка принята»", "Kafka")
Rel(mapper, start_client, "Готовит переменные процесса")
Rel(start_client, pipeline, "Стартует процесс по заявке", "REST")
Rel(pipeline, decision_consumer, "Возвращает решение и статусы", "REST / вебхук")
Rel(decision_consumer, kafka, "Публикует решение по заявке", "Kafka")
Rel(kafka, events, "Решение и статусы по заявке", "Kafka")
Rel(events, registry, "Обновляет статус заявки")
Rel(kafka, notify, "Запросы уведомлений о статусе", "Kafka")
Rel(abs_adapter, kafka, "Заявка, оформленная в отделении", "Kafka")

Rel(night, segmenter, "Запускает отбор клиентов")
Rel(segmenter, offer_db, "Читает витрину сегментации", "JDBC")
Rel(segmenter, batch_client, "Передаёт пачку клиентов")
Rel(batch_client, scoring, "Пакетный скоринг в непиковые часы", "REST")
Rel(batch_client, offer_store, "Сохраняет рассчитанные предложения")
Rel(offer_store, offer_db, "Читает и пишет", "JDBC")
Rel(offer_api, offer_store, "Читает действующее предложение")
Rel(recheck, scoring_client, "Запрашивает лёгкий профиль скоринга")
Rel(recheck, offer_store, "Сверяет условия предложения")

SHOW_LEGEND()
@enduml
