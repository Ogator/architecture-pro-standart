@startuml
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()

title Диаграмма контекста C4 — подача заявки на кредит онлайн (целевое состояние, горизонт года)

Person(prospect, "Потенциальный клиент", "Новый клиент. Подаёт заявку на сайте, при вводе паспортных данных получает предварительное решение сразу")
Person(client, "Клиент банка", "Пользователь интернет-банка. Видит предодобренное предложение и подаёт быструю заявку")
Person(front, "Сотрудник фронт-офиса", "Идентифицирует клиента, продолжает работу с заявкой, поданной онлайн, или заводит новую")
Person(credit_manager, "Менеджер отдела кредитования", "Обрабатывает заявки в Кредитном конвейере и принимает решение о выдаче")

System(online_platform, "Платформа онлайн-продуктов", "Расширение контура MVP депозитов: витрина кредитных предложений, приём и жизненный цикл кредитных заявок, предодобренные предложения, уведомления")

System(site, "Сайт банка", "Витрина кредитных продуктов и форма заявки для новых клиентов")
System(ib, "Интернет-банк", "Витрина, предодобренное предложение и быстрая заявка для действующих клиентов")
System(abs, "АБС", "Данные клиента, счета, зачисление кредитных средств, оформление заявки в отделении")
System(pipeline, "Кредитный конвейер", "BPM Camunda: обработка заявок, решение о выдаче. Горизонтально масштабируется, работает 24/7")
System(scoring, "Система кредитного скоринга", "Рейтинг клиента. Перегружена в рабочие часы, предрасчёты недопустимы")
System(sms_gw, "СМС-шлюз", "Отправка кодов подтверждения и уведомлений о статусе заявки")

System_Ext(bki, "Бюро кредитных историй", "Внешний REST API: кредитная история, для нового клиента — только общие данные")
System_Ext(telecom, "Телеком-оператор", "Доставка СМС клиенту")

Rel(prospect, site, "Смотрит условия, подаёт заявку, получает предварительное решение", "HTTPS")
Rel(client, ib, "Видит предодобренное предложение, подаёт заявку, следит за статусом", "HTTPS")
Rel(site, online_platform, "Витрина условий, подача заявки, запрос предварительного решения", "HTTPS / REST")
Rel(ib, online_platform, "Витрина, предодобренное предложение, подача заявки, подтверждение кодом", "HTTPS / REST")

Rel(online_platform, pipeline, "Передаёт заявку онлайн в обход суточного обмена, получает решение и статусы", "REST + события")
Rel(online_platform, scoring, "Экспресс-скоринг по заявке с сайта и упрощённый повторный скоринг; пакетный расчёт предложений — только в непиковые часы", "REST")
Rel(online_platform, abs, "Ищет клиента и заявку, инициирует зачисление средств", "PL/SQL API интеграционной схемы")
Rel(online_platform, sms_gw, "Коды подтверждения и уведомления о статусе заявки", "SMPP / HTTP")

Rel(scoring, bki, "Запрашивает кредитную историю", "REST, онлайн")
Rel(pipeline, scoring, "Запрашивает скоринг при обработке заявки", "REST")
Rel(credit_manager, pipeline, "Обрабатывает заявку и принимает решение")
Rel(front, abs, "Идентифицирует клиента, продолжает онлайн-заявку или создаёт новую")
Rel(abs, online_platform, "Передаёт заявку из отделения и подтверждает зачисление средств", "PL/SQL API интеграционной схемы")
Rel(sms_gw, telecom, "Отправляет СМС", "SMPP")
Rel_U(telecom, client, "Доставляет СМС")

SHOW_LEGEND()
@enduml
