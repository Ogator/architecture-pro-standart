@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()

title Диаграмма компонентов C4 — распространение ставок: сервис витрины и ставок и сервис публикации ставок

Person(cc_operator, "Оператор кол-центра банка", "Смотрит актуальные ставки в своей системе")
System_Ext(pcc_side, "Партнёрский кол-центр", "Забирает файл ставок с SFTP по ключу")

Container(gw, "API Gateway / BFF", "Spring Cloud Gateway", "Единая точка входа: TLS, аутентификация, ограничение частоты запросов")
Container(cc_sys, "Система кол-центра банка", "React + Java Spring Boot", "Рабочее место оператора, новый экран «Актуальные ставки»")
ContainerQueue(kafka, "Шина событий", "Apache Kafka", "Топик обновления справочника ставок")
ContainerDb(db, "БД платформы депозитов", "PostgreSQL", "Реплика справочника ставок и журнал выгрузок")
ContainerDb(cache, "Кэш витрины", "Redis", "Актуальный срез ставок")
Container(sftp, "Узел файлового обмена", "SFTP-сервер в DMZ", "Каталог партнёра: файл ставок, манифест, контрольная сумма")
Container(obs, "Мониторинг и алертинг", "Prometheus + Grafana", "Метрики свежести ставок и успешности выгрузок")

Container_Boundary(rate_svc, "Сервис витрины и ставок (Java 17, Spring Boot)") {
  Component(sync, "Обработчик обновления ставок", "Kafka Listener", "Принимает событие «ставки утверждены», проверяет версию и дату действия, обновляет реплику")
  Component(repo, "Хранилище справочника ставок", "Spring Data JPA", "Версионированный справочник: продукт, срок, сумма, ставка, дата начала действия")
  Component(cachemgr, "Менеджер кэша", "Spring Cache, Redis", "Прогревает и инвалидирует срез ставок при обновлении")
  Component(public_api, "API витрины для клиентских каналов", "REST Controller", "Отдаёт срез версии N в профиле public: продукты, доступные для оформления в канале")
  Component(operator_api, "API ставок для операторов", "REST Controller", "Отдаёт срез версии N в профиле operator: вся продуктовая сетка, включая продукты только для отделения, и служебные атрибуты. Сервисный токен, отдельная роль.")
  Component(snapshot, "Поставщик среза ставок", "Domain Service", "Хранит указатель текущей опубликованной версии. Синхронным потребителям отдаёт текущий срез в нужном профиле и возвращает номер версии в ответе; асинхронным — строго запрошенную версию либо ответ «версия недоступна»")
  Component(ready_pub, "Издатель события готовности среза", "Kafka Producer", "Публикует событие «срез версии N готов»")
}

Container_Boundary(pub_svc, "Сервис публикации ставок (Java 17, Spring Boot)") {
  Component(sched, "Планировщик публикаций", "Spring Scheduler", "Публикация по расписанию (утро рабочего дня) и по событию «срез версии N готов».")
  Component(builder, "Формирователь файла", "CSV / XLSX Writer", "Готовит файл в согласованном с партнёром формате из среза версии N в профиле public — того же, что видит клиент на сайте")
  Component(manifest, "Манифест и контрольная сумма", "Domain Service", "Номер версии, дата и время формирования, срок действия, SHA-256 файла")
  Component(publisher, "Публикатор SFTP", "Apache MINA SSHD Client", "Атомарная выкладка файла")
  Component(audit, "Журнал и контроль доставки", "Domain Service", "Хранит номер последней опубликованной версии: повтор той же версии игнорируется, версия ниже текущей не публикуется. Фиксирует факт публикации и забора файла, поднимает алерт при просрочке")
}

Rel(kafka, sync, "Событие «справочник ставок утверждён»", "Kafka")
Rel(sync, repo, "Сохраняет новую версию справочника")
Rel(sync, cachemgr, "Инициирует инвалидацию и прогрев")
Rel(sync, ready_pub, "После фиксации версии и прогрева кэша даёт команду опубликовать событие готовности новой версии среза")
Rel(ready_pub, kafka, "Публикует событие «срез версии N готов»", "Kafka")
Rel(repo, db, "Читает и пишет", "JDBC")
Rel(cachemgr, cache, "Пишет срез под ключом с номером версии — устаревшее значение отдать нельзя", "RESP")
Rel(snapshot, repo, "Запрашивает версию справочника")
Rel(snapshot, cachemgr, "Читает готовый срез")
Rel(public_api, snapshot, "Запрашивает текущий срез, профиль public; номер версии приходит в ответе")
Rel(operator_api, snapshot, "Запрашивает текущий срез, профиль operator; номер версии приходит в ответе")

Rel(gw, public_api, "Витрина для сайта и интернет-банка", "REST")
Rel(cc_sys, gw, "Запрашивает актуальные ставки", "HTTPS / REST, сервисный токен")
Rel(gw, operator_api, "Маршрутизирует запрос системы кол-центра", "REST")
Rel(cc_operator, cc_sys, "Открывает экран «Актуальные ставки»")

Rel(sched, snapshot, "Запрашивает срез: версия N из события, профиль public. На ответ «версия недоступна» — повтор с нарастающей задержкой")
Rel(kafka, sched, "Событие «срез версии N готов» — публикуется только после обновления реплики", "Kafka")
Rel(sched, audit, "Проверяет, не опубликована ли уже версия N")
Rel(sched, builder, "Запускает формирование файла для версии N")
Rel(builder, manifest, "Запрашивает версию и контрольную сумму")
Rel(builder, publisher, "Передаёт готовый файл и манифест")
Rel(publisher, sftp, "Выкладывает файл, манифест и контрольную сумму", "SFTP")
Rel(publisher, audit, "Фиксирует результат публикации")
Rel(audit, db, "Хранит журнал выгрузок и заборов", "JDBC")
Rel(audit, sftp, "Проверяет, забран ли файл партнёром", "SFTP")
Rel(audit, obs, "Метрики свежести и доставки", "HTTP")
Rel(cachemgr, obs, "Метрика возраста среза ставок", "HTTP")
Rel(pcc_side, sftp, "Забирает файл по ключу", "SFTP")

SHOW_LEGEND()
@enduml
