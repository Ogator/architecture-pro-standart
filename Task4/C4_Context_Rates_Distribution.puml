@startuml
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()

title Диаграмма контекста C4 — передача актуальных ставок по депозитам в кол-центры

Person(client, "Клиент банка", "Звонит, чтобы уточнить условия открытия депозита")
Person(cc_operator, "Оператор кол-центра банка", "200 чел. Консультирует по актуальным ставкам")
Person(pcc_operator, "Оператор партнёрского кол-центра", "100 чел. Работает во внешней системе по скриптам банка")
Person(bo_deposit, "Менеджер бэк-офиса депозитов", "Утверждает справочник ставок")
Person(bo_credit, "Менеджер отдела кредитования", "Ведёт показатели кредитного риска")
Person(partner_admin, "Ответственный партнёрского кол-центра", "Забирает файл ставок и доводит его до операторов")

System(abs, "АБС", "Источник истины по ставкам: справочник ставок и процесс согласования")
System(deposit_platform, "Платформа депозитов онлайн", "Реплика справочника ставок. Отдаёт ставки по API и публикует файл выгрузки для внешних получателей")
System(cc, "Система кол-центра банка", "Платформа подрядчика. Рабочее место оператора: обращения, звонки и новый экран актуальных ставок")
System(sftp, "Узел файлового обмена", "SFTP-сервер в DMZ банка. Точка передачи файла ставок партнёру")

System_Ext(pcc, "Система партнёрского кол-центра", "Внешняя система другой компании. API-интеграция невозможна, обмен только файлами")

Rel(bo_credit, abs, "Вносит показатели кредитного риска")
Rel(bo_deposit, abs, "Рассчитывает и утверждает ставки на день")
Rel(abs, deposit_platform, "Публикует утверждённый справочник ставок", "PL/SQL API → шина событий")

Rel(cc, deposit_platform, "Запрашивает актуальные ставки", "HTTPS / REST, сервисный токен")
Rel(deposit_platform, sftp, "Публикует файл ставок, манифест и контрольную сумму", "SFTP, по расписанию и по событию")
Rel(partner_admin, sftp, "Забирает файл ставок", "SFTP, доступ по ключу")
Rel(partner_admin, pcc, "Загружает ставки и обновляет скрипты звонков")

Rel(client, cc_operator, "Звонит и спрашивает условия депозита")
Rel(client, pcc_operator, "Принимает звонок партнёрского кол-центра")
Rel(cc_operator, cc, "Смотрит актуальные ставки при разговоре")
Rel(pcc_operator, pcc, "Смотрит ставки из загруженного файла")

SHOW_LEGEND()
@enduml
