@startuml
!include <C4/C4_Context>

title Диаграмма контекста C4 — открытие депозитов онлайн (MVP), банк «Стандарт»

Person(prospect, "Потенциальный клиент", "Новый клиент, ещё не обслуживается в банке. Работает с сайтом")
Person(client, "Клиент банка", "Действующий клиент с доступом в интернет-банк")
Person(cc_manager, "Менеджер кол-центра", "Обрабатывает заявки с сайта, предлагает особые условия")
Person(bo_deposit, "Менеджер бэк-офиса депозитов", "Согласует ставку и подтверждает условия депозита")
Person(bo_credit, "Менеджер отдела кредитования", "Ведёт данные о кредитном риске банка для расчёта ставок")
Person(front, "Сотрудник фронт-офиса", "Идентифицирует нового клиента в отделении")

System(deposit_platform, "Платформа депозитов онлайн (новая)", "Витрина ставок, приём и жизненный цикл заявок на депозит, уведомления и коды подтверждения. Разрабатывается силами банка")

System(site, "Сайт банка", "PHP + React.js. Витрина продуктов и форма заявки для новых клиентов")
System(ib, "Интернет-банк", "ASP.NET MVC 4.5 / MS SQL, монолит на платформе подрядчика. Аутентификация клиента, платежи, счета")
System(abs, "АБС", "Delphi + Oracle / PL-SQL. Учёт счетов и депозитов, справочник ставок, согласование условий")
System(cc, "Система кол-центра", "Платформа подрядчика: React + Java Spring Boot + PostgreSQL. Обращения и звонки")
System(sms_gw, "СМС-шлюз", "Шлюз банка к телеком-оператору")

System_Ext(telecom, "Телеком-оператор", "Внешний сервис отправки СМС")

Rel(prospect, site, "Смотрит ставки, оставляет заявку на депозит", "HTTPS")
Rel(client, ib, "Смотрит персональные ставки, подаёт заявку, видит статус", "HTTPS")
Rel(prospect, front, "Приходит в отделение для идентификации")

Rel(site, deposit_platform, "Запрашивает витрину ставок, передаёт заявку", "HTTPS / REST")
Rel(ib, deposit_platform, "Запрашивает витрину и персональные ставки, передаёт заявку, запрашивает код подтверждения", "HTTPS / REST")

Rel(deposit_platform, cc, "Создаёт обращение по заявке с сайта", "REST")
Rel_D(deposit_platform, abs, "Передаёт заявки, получает ставки и события по заявкам", "Асинхронный обмен через выделенную схему Oracle")
Rel(deposit_platform, sms_gw, "Отправляет коды подтверждения и уведомления", "SMPP / HTTP")
Rel(sms_gw, telecom, "Отправляет СМС", "SMPP")
Rel_U(telecom, client, "Доставляет СМС клиенту")

Rel(cc_manager, cc, "Обрабатывает заявку, фиксирует особые условия")
Rel(bo_deposit, abs, "Ведёт ставки, согласует условия, открывает депозит")
Rel(bo_credit, abs, "Ведёт показатели кредитного риска для расчёта ставок")
Rel(front, abs, "Идентифицирует клиента, оформляет документы")

SHOW_LEGEND()
@enduml
