@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam wrapWidth 180
skinparam maxMessageSize 160

title Диаграмма контейнеров C4 — открытие депозитов онлайн (MVP), банк «Стандарт»

Person(prospect, "Потенциальный клиент", "Новый клиент, работает с сайтом")
Person(client, "Клиент банка", "Пользователь интернет-банка")
Person(cc_manager, "Менеджер кол-центра", "Обрабатывает заявки с сайта")
Person(bo_deposit, "Менеджер бэк-офиса депозитов", "Ведёт ставки, согласует условия, открывает депозит")
Person(bo_credit, "Менеджер отдела кредитования", "Ведёт показатели кредитного риска")
Person(front, "Сотрудник фронт-офиса", "Идентифицирует клиента в отделении")

System_Boundary(site_b, "Сайт банка") {
  Container(site_spa, "SPA сайта", "React.js", "Витрина депозитов и форма заявки для новых клиентов")
  Container(site_be, "Бэкенд сайта", "PHP", "Отдаёт страницы и статику сайта. Вызовы к API платформы депозитов идут напрямую из SPA в API Gateway")
}

System_Boundary(ib_b, "Интернет-банк (монолит на платформе подрядчика)") {
  Container(ib_ui, "Веб-интерфейс ИБ", "ASP.NET MVC 4.5, Razor", "Существующие экраны: платежи, счета. Встраивает новый раздел «Депозиты»")
  Container(ib_mfe, "Микрофронтенд «Депозиты»\n(новый)", "React.js", "Витрина и персональные ставки, форма заявки, ввод СМС-кода, статус заявки. Разработка команды банка")
  Container(ib_core, "Ядро ИБ", ".NET Framework 4.5", "Аутентификация, платежи, текущие счета, штатный СМС-функционал. Изменяется только подрядчиком — НЕ дорабатывается")
  Container(ib_token, "Сервис выдачи токена клиента\n(новый)", ".NET, ASP.NET", "Обменивает сессию ИБ на короткоживущий токен для вызовов новой платформы")
  ContainerDb(ib_db, "БД интернет-банка", "MS SQL", "Данные монолита ИБ")
}

System_Boundary(dp_b, "Платформа депозитов онлайн (новая, разработка банка)") {
  Container(gw, "API Gateway", "Java 17, Spring Cloud Gateway", "Единая точка входа для сайта и ИБ: TLS, проверка токена, ограничение частоты запросов, маршрутизация")
  Container(catalog, "Сервис витрины и ставок", "Java 17, Spring Boot", "Отдаёт список депозитных продуктов, актуальные и персональные ставки")
  Container(application, "Сервис заявок на депозит", "Java 17, Spring Boot", "Жизненный цикл и статусы заявки, идемпотентность, аудит")
  Container(notify, "Сервис уведомлений и кодов подтверждения", "Java 17, Spring Boot", "Генерация и проверка СМС-кода, отправка уведомлений клиенту")
  Container(abs_adapter, "Адаптер АБС", "Java 17, Spring Boot", "Передаёт заявки в АБС и забирает ставки и события по депозитам")
  Container(cc_adapter, "Адаптер кол-центра", "Java 17, Spring Boot", "Создаёт обращение по заявке с сайта")
  ContainerDb(dp_db, "БД платформы депозитов", "PostgreSQL", "Заявки, статусы, коды подтверждения, реплика справочника ставок")
  ContainerDb(cache, "Кэш витрины", "Redis", "Ставки и справочные данные для отклика в миллисекундах")
  ContainerQueue(kafka, "Шина событий", "Apache Kafka", "Заявки, изменения ставок, события статусов, запросы уведомлений")
}

System_Boundary(abs_b, "АБС — автоматизированная банковская система") {
  Container(abs_client, "Десктоп-клиент АБС", "Delphi", "Рабочее место фронт-офиса и бэк-офиса")
  Container(abs_rates, "Модуль ставок и согласования\n(новый)", "PL/SQL + формы Delphi", "Справочник ставок вместо XLS, согласование ставки по заявке, разграничение прав депозиты/кредиты")
  Container(abs_core, "Ядро АБС", "PL/SQL", "Счета, депозиты, проводки, документы, кредитный риск")
  ContainerDb(abs_db, "Основная схема АБС", "Oracle", "Учётные данные банка. Масштабируется только вертикально, уже нагружена")
  Container(abs_api, "Интеграционный API АБС\n(новый)", "PL/SQL package", "Опубликованный командой АБС контракт: приём заявки, выдача ставок и событий. Единственная точка входа в АБС извне")
  ContainerDb(abs_stg, "Интеграционная схема\n(новая)", "Oracle, отдельная схема и учётная запись", "Буфер обмена: входящие заявки, исходящие ставки и события. Прав на основную схему у интеграционной учётной записи нет")
}

System(cc, "Система кол-центра", "Платформа подрядчика: React + Java Spring Boot + PostgreSQL")
System(sms_gw, "СМС-шлюз", "Шлюз банка к телеком-оператору")
System_Ext(telecom, "Телеком-оператор", "Внешняя отправка СМС")

Rel(prospect, site_spa, "Смотрит ставки, оставляет заявку", "HTTPS")
Rel(client, ib_ui, "Работает в интернет-банке", "HTTPS")
Rel(site_spa, site_be, "Загружает страницы и статику", "HTTPS")
Rel(site_spa, gw, "Витрина ставок, отправка заявки с сайта", "HTTPS / REST")

Rel(ib_ui, ib_mfe, "Встраивает раздел «Депозиты»")
Rel(ib_ui, ib_core, "Аутентификация и текущие операции")
Rel(ib_core, ib_db, "Читает и пишет", "ADO.NET")
Rel(ib_mfe, ib_token, "Получает токен по сессии клиента", "HTTPS / REST")
Rel(ib_token, ib_db, "Проверяет сессию клиента", "ADO.NET")
Rel(ib_mfe, gw, "Витрина, персональные ставки, подача заявки, подтверждение кодом", "HTTPS / REST + Bearer-токен")
Rel(gw, ib_token, "Проверяет токен клиента", "HTTPS / REST")

Rel(gw, catalog, "Запрашивает витрину и персональные ставки", "REST")
Rel(gw, application, "Создаёт заявку, отдаёт статус", "REST")
Rel(gw, notify, "Запрашивает и проверяет код подтверждения", "REST")
Rel(catalog, cache, "Читает и обновляет кэш", "RESP")
Rel(catalog, dp_db, "Читает реплику справочника ставок", "JDBC")
Rel(application, dp_db, "Хранит заявки и статусы", "JDBC")
Rel(notify, dp_db, "Хранит коды и журнал отправок", "JDBC")
Rel(application, kafka, "Публикует событие «заявка создана»", "Kafka")
Rel(notify, kafka, "Подписан на события статусов заявки", "Kafka")
Rel(catalog, kafka, "Подписан на обновление ставок", "Kafka")
Rel(abs_adapter, kafka, "Читает заявки, публикует ставки и события", "Kafka")
Rel(cc_adapter, kafka, "Читает заявки с сайта", "Kafka")

Rel(abs_adapter, abs_api, "Вызывает опубликованные процедуры: передаёт заявки, забирает ставки и события", "JDBC / CALL")
Rel(abs_api, abs_stg, "Читает и пишет буферные таблицы")
Rel(abs_rates, abs_stg, "Публикует актуальные ставки")
Rel(abs_core, abs_stg, "Забирает заявки, публикует события по депозиту")
Rel(abs_rates, abs_db, "Хранит справочник ставок")
Rel(abs_core, abs_db, "Читает и пишет учётные данные")
Rel(abs_client, abs_rates, "Ведение ставок и согласование условий")
Rel(abs_client, abs_core, "Открытие депозита, документы")

Rel(cc_adapter, cc, "Создаёт обращение по заявке", "REST")
Rel(cc_manager, cc, "Обрабатывает заявку, фиксирует особые условия")
Rel(notify, sms_gw, "Отправляет коды и уведомления", "SMPP / HTTP")
Rel(sms_gw, telecom, "Отправляет СМС", "SMPP")
Rel(telecom, client, "Доставляет СМС клиенту")

Rel(bo_deposit, abs_client, "Работает в АБС")
Rel(bo_credit, abs_client, "Ведёт показатели кредитного риска")
Rel(front, abs_client, "Идентифицирует клиента, оформляет документы")

Lay_D(kafka, abs_stg)
Lay_D(kafka, abs_client)
Lay_D(ib_db, cc)
Lay_R(site_b, ib_b)

SHOW_LEGEND()
@enduml
